+        assert_eq!(
+            run(&expired, &mut previous).unwrap_err().reason,
+            RefusalReason::Deadline
+        );
+        let recovered = run(
+            &Config {
+                deadline: Deadline::after(Duration::from_secs(30)),
+                ..deeper
+            },
+            &mut previous,
+        )
+        .unwrap();
         assert_eq!(recovered.actions, cold.actions);
     }
 }
